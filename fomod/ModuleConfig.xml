<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>OStim Together 0.26.0 STRPM</moduleName>
  <requiredInstallFiles>
    <folder source="00 Core" destination="" priority="0" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Optional integrations">
      <optionalFileGroups order="Explicit">
        <group name="OStim Together integrations" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="OCum Ascended synchronization">
              <description>Synchronizes OCum Ascended RaceMenu cum overlays and its actual vaginal/anal OStim equip-object meshes between Skyrim Together players. Requires OCum Ascended on both clients.</description>
              <files>
                <folder source="10 OCum Ascended" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="OCum.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="OStim Add Actor consent gate">
              <description>Recommended for multiplayer. Patches OStim's UIExtensions message-box bridge so selecting a remote player in Add Actor pauses the setup before role selection/fade until that player accepts. OSKSE.pex from this component must win its file conflict with OStim.</description>
              <files>
                <folder source="20 OStim Add Actor Consent Gate" destination="" priority="50" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="OStim.esp" state="Active" />
                        <fileDependency file="UIExtensions.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
