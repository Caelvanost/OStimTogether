<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>OStim Together 0.33.0</moduleName>
  <requiredInstallFiles>
    <folder source="00 Core" destination="" priority="0" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Optional integrations">
      <optionalFileGroups order="Explicit">
        <group name="OStim Together integrations" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="OCum Ascended synchronization">
              <description>Synchronizes OCum Ascended RaceMenu cum overlays and its actual vaginal/anal OStim equip-object meshes between Skyrim Together players. Requires OCum Ascended on both clients.</description>
              <files>
                <folder source="10 OCum Ascended" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="OCum.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="PPA - Procedural Penis Animations synchronization">
              <description>Synchronizes PPA runtime penetration targets between Skyrim Together scene participants, including per-stage target site and explicit target actor in multi-actor scenes. Requires AccuratePenetration.dll on both clients. OStim Together validates the exact supported PPA runtime build before installing its hooks and disables the integration safely if the DLL is unsupported.</description>
              <files>
                <folder source="20 Procedural Penis Animations" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <!-- DLLs are not load-order plugins. Some FOMOD hosts report
                       an installed SKSE DLL as Inactive even though the file is
                       present and will be loaded by SKSE. Keep the integration
                       manually selectable as a safe fallback, and recommend it
                       whenever AccuratePenetration.dll is present in either
                       state. Runtime exact-build validation remains authoritative. -->
                  <defaultType name="Optional" />
                  <patterns>
                    <pattern>
                      <dependencies operator="Or">
                        <fileDependency file="SKSE/Plugins/AccuratePenetration.dll" state="Active" />
                        <fileDependency file="SKSE/Plugins/AccuratePenetration.dll" state="Inactive" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
