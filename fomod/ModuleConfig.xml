<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>OStim Together 0.33.2</moduleName>
  <requiredInstallFiles>
    <folder source="00 Core" destination="" priority="0" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Optional integrations">
      <optionalFileGroups order="Explicit">
        <group name="OStim Together integrations" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="OCum Ascended synchronization">
              <description>Synchronizes OCum Ascended RaceMenu cum overlays and its actual vaginal/anal OStim equip-object meshes between Skyrim Together players. v0.33.2 rematerializes changed CumOverlays through RaceMenu's normal ActorUpdateManager pipeline. Requires OCum Ascended on both clients.</description>
              <files>
                <folder source="10 OCum Ascended" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="NotUsable" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="OCum.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="PPA - Procedural Penis Animations synchronization">
              <description>Synchronizes PPA runtime penetration targets between Skyrim Together scene participants, including per-stage target site and explicit target actor in multi-actor scenes. Automatically pre-selected when AccuratePenetration.dll is detected. Requires AccuratePenetration.dll on both clients. OStim Together validates the exact supported PPA runtime build and uses direct absolute x64 setter detours with no rel32/ASLR distance dependency.</description>
              <files>
                <folder source="20 Procedural Penis Animations" destination="" priority="0" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <!-- Recommended is pre-selected but remains user-deselectable.
                       Vortex/FOMOD hosts may report an installed SKSE DLL either
                       Active or Inactive because DLLs are not load-order plugins.
                       Use separate patterns for maximum installer compatibility.
                       If neither state matches, keep the option manually selectable. -->
                  <defaultType name="Optional" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="SKSE/Plugins/AccuratePenetration.dll" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="SKSE/Plugins/AccuratePenetration.dll" state="Inactive" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
